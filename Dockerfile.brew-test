# Test Homebrew formula in Docker using Linuxbrew.
# Builds the binary locally first, creates a fake release tarball,
# copies it into the container, then runs brew install + brew test.
#
# Usage:
#   CGO_ENABLED=0 go build -o /tmp/brew-test-assets/watcher ./cmd/watcher/
#   cd /tmp/brew-test-assets && tar czf agent-status-v0.1.0-darwin-arm64.tar.gz watcher
#   docker build -t brew-test -f Dockerfile.brew-test ..
#   docker run --rm -it brew-test

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl file git procps \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m brew && echo 'brew ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

USER brew
WORKDIR /home/brew

RUN NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
ENV PATH="/home/brew/.linuxbrew/bin:/home/brew/.linuxbrew/sbin:$PATH"

# Copy the release tarball (built on host before docker build)
COPY --chown=brew:brew agent-status-v0.1.0-darwin-arm64.tar.gz /tmp/

# Formula modified to use a local file URL for testing
RUN cat > /home/brew/agent-status.rb << 'FORMULA'
class AgentStatus < Formula
  desc "Track AI agent sessions in the tmux window list"
  homepage "https://github.com/jvrsantacruz/agent-status"
  license "MIT"
  version "0.1.0"

  url "file:///tmp/agent-status-v0.1.0-darwin-arm64.tar.gz"
  sha256 "CHANGE_ME"

  def install
    bin.install "watcher"
  end

  test do
    assert_match "usage", shell_output("#{bin}/watcher emit 2>&1", 1)
    assert_match "usage", shell_output("#{bin}/watcher render 2>&1")
  end
end
FORMULA

# Fill in the SHA256
RUN sha=$(sha256sum /tmp/agent-status-v0.1.0-darwin-arm64.tar.gz | cut -d' ' -f1) \
    && sed -i "s/\"CHANGE_ME\"/\"$sha\"/" /home/brew/agent-status.rb

RUN brew install --verbose /home/brew/agent-status.rb \
    && echo "=== INSTALL OK ==="

RUN brew test agent-status \
    && echo "=== TEST OK ==="

RUN watcher emit 2>&1 | grep -q usage \
    && watcher render 2>&1 \
    && echo "=== BINARY OK ==="

CMD ["brew", "list", "agent-status"]
